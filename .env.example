# Copy to .env and fill in values. Never commit .env.

# Claude API key (RAG answer synthesis)
ANTHROPIC_API_KEY=

# Snowflake demo target. Only ACCOUNT/USER/PASSWORD feed the make
# targets — make dbt-snowflake and make load-snowflake pin role,
# warehouse, database, and schema to the terraform-created objects.
# The rest are read by direct `dbt --target snowflake` invocations.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Terraform only: the two halves of SNOWFLAKE_ACCOUNT (<org>-<account>).
# The terraform shell must also UNSET SNOWFLAKE_ACCOUNT and
# SNOWFLAKE_WAREHOUSE — see terraform/README.md.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=
# Snowflake user granted TRANSFORMER (exact case per SHOW USERS' name
# column) — a terraform variable, not a secret
TF_VAR_snowflake_admin_user=

# Named AWS CLI profile used by Terraform and S3 uploads (eu-west-3)
AWS_PROFILE=
