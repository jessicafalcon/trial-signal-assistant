.env
.env.*
# root file only (was any-depth): the one sanctioned exception, and the
# floor's check (f) asserts it holds bare keys with no values
!/.env.example
.envrc*
*.env
.venv/
data/
*.duckdb
dbt_project/target/
dbt_project/logs/
# container-side dbt artifacts (per-environment split — the DAG sets
# DBT_TARGET_PATH/DBT_LOG_PATH so host and container never share the
# path-bearing partial-parse cache)
dbt_project/target_container/
dbt_project/logs_container/
dbt_project/dbt_packages/
dbt_project/.user.yml
__pycache__/
.pytest_cache/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# terraform plan files archive resource values (incl. sensitive outputs)
# in cleartext; provider crash logs can contain request/response bodies
*.tfplan
tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc
*.pem
*.p8
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
*.jks
.DS_Store
.astro/
.claude/settings.local.json

# raw demo captures (unredacted screenshots/recordings) — assets are
# curated into docs/assets/ after redaction; originals never committed
demo/
